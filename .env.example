# Use a long, unique random secret in any non-throwaway environment.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: explicit development frontend origins for testing from another device.
# Example only. Adapt the IP and port to your computer's LAN address.
# SEPPYL_ALLOWED_ORIGINS=http://192.168.1.50:8080

# Compile-time frontend configuration (set as an environment variable before dx serve):
# SEPPYL_API_URL=http://192.168.1.50:3000
