# Use a long, unique random secret in any non-throwaway environment.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: explicit development frontend origins for testing from another device.
# Example only. Adapt the IP and port to your computer's LAN address.
# SEPPYL_ALLOWED_ORIGINS=http://192.168.1.50:8080

# Compile-time frontend configuration (set as an environment variable before dx serve):
# SEPPYL_API_URL=http://192.168.1.50:3000

# Optional Discord notifications for support tickets (API process only).
# Keep the real webhook URL in a private .env, never in Git.
# SEPPYL_DISCORD_TICKET_WEBHOOK=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Optional: Discord role ID to ping on ticket creation / Maintainer escalation.
# SEPPYL_DISCORD_TICKET_ROLE_ID=123456789012345678

# Discord interactive support (requires Discord Developer Portal application).
# Public key is not secret; the bot token is secret and must never enter Git.
# SEPPYL_DISCORD_PUBLIC_KEY=64_HEX_CHARACTERS_FROM_DISCORD
# SEPPYL_DISCORD_APPLICATION_ID=123456789012345678
# SEPPYL_DISCORD_GUILD_ID=123456789012345678
# Optional: use the bot itself for notifications with buttons instead of a webhook.
# SEPPYL_DISCORD_BOT_TOKEN=BOT_TOKEN_FROM_DISCORD
# SEPPYL_DISCORD_CHANNEL_ID=123456789012345678
